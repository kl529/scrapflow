{
  "name": "scrapflow",
  "version": "1.0.0",
  "description": "\uc2a4\ud06c\ub9b0\uc0f7 \uae30\ubc18 \uc2a4\ud06c\ub7a9\ubd81 \ub370\uc2a4\ud06c\ud1b1 \uc560\ud50c\ub9ac\ucf00\uc774\uc158",
  "main": "build/main/main.js",
  "homepage": "./",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev-react\" \"wait-on http://localhost:3000 && electron .\"",
    "dev-react": "react-scripts start",
    "build": "react-scripts build && npm run copy-main",
    "copy-main": "cp -r src/main build/ && cp logo.png build/ && cp icon.icns build/ 2>/dev/null || true",
    "build-electron": "npm run build && electron-builder",
    "build-win": "npm run build && electron-builder --win",
    "build-mac": "npm run build && electron-builder --mac",
    "build-all": "npm run build && electron-builder --win --mac",
    "postinstall": "electron-builder install-app-deps",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "keywords": [
    "electron",
    "react",
    "screenshot",
    "scrapbook",
    "desktop-app"
  ],
  "author": "ScrapFlow Team",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "date-fns": "^2.30.0",
    "electron-is-dev": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.15.0",
    "screenshot-desktop": "^1.15.0",
    "tesseract.js": "^6.0.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.15",
    "concurrently": "^8.2.2",
    "electron": "^26.0.0",
    "electron-builder": "^24.6.4",
    "postcss": "^8.4.29",
    "react-scripts": "^5.0.1",
    "tailwindcss": "^3.3.3",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.scrapflow.app",
    "productName": "ScrapFlow",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "build/main/main.js",
      "description": "\uc2a4\ud06c\ub9b0\uc0f7 \uae30\ubc18 \uc2a4\ud06c\ub7a9\ubd81 - \uc0dd\uac01\uc744 \uae30\ub85d\ud558\uace0 \uc544\uc774\ub514\uc5b4\ub97c \uc5f0\uacb0\ud558\uc138\uc694"
    },
    "publish": {
      "provider": "github",
      "owner": "kl529",
      "repo": "scrapflow"
    },
    "icon": "icon.icns",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "win": {
      "icon": "logo.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "publisherName": "ScrapFlow",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "react-router": {
      "@remix-run/router": "1.23.4"
    },
    "react-router-dom": {
      "@remix-run/router": "1.23.4"
    }
  }
}
